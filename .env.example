# Copy to .env and fill in what you need. Everything has a safe default;
# API keys are only required for experiments that use real providers —
# the test suite runs entirely on mocks.

# --- Application settings (ARB_ prefix) ---
ARB_LOG_LEVEL=INFO
ARB_LOG_FORMAT=console        # console | json
ARB_DATA_DIR=data
ARB_REPORTS_DIR=reports

# --- Provider credentials (never committed, never logged) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Services ---
QDRANT_URL=http://localhost:6333
